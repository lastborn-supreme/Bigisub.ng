<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Bigisub.ng - Dashboard</title>
  <!-- Tailwind CSS CDN -->
  <script src="https://cdn.tailwindcss.com"></script>
  <!-- FontAwesome Icons -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
</head>
<body class="bg-gray-100 font-sans">

  <!-- Navigation Bar -->
  <nav class="bg-indigo-900 text-white px-4 py-3 flex justify-between items-center shadow-md">
    <div class="flex items-center space-x-2">
      <span class="text-xl font-bold tracking-wide">Bigisub<span class="text-indigo-400">.ng</span></span>
    </div>
    <div class="flex items-center space-x-4">
      <button class="relative text-gray-300 hover:text-white">
        <i class="fa-solid fa-bell text-lg"></i>
        <span class="absolute -top-1 -right-1 bg-red-500 text-xs text-white rounded-full h-4 w-4 flex items-center justify-center">2</span>
      </button>
      <div class="flex items-center space-x-2">
        <div class="w-8 h-8 rounded-full bg-indigo-500 flex items-center justify-center font-bold">U</div>
        <span class="hidden md:inline font-medium text-sm">User</span>
      </div>
    </div>
  </nav>

  <!-- Main Container -->
  <main class="max-w-4xl mx-auto p-4 space-y-6">

    <!-- Wallet Summary Card -->
    <div class="bg-gradient-to-r from-indigo-900 to-indigo-700 rounded-2xl p-6 text-white shadow-lg">
      <div class="flex justify-between items-start">
        <div>
          <p class="text-indigo-200 text-sm">Wallet Balance</p>
          <h2 class="text-3xl font-extrabold mt-1">₦ 15,450.00</h2>
        </div>
        <button class="bg-emerald-500 hover:bg-emerald-600 text-white font-medium px-4 py-2 rounded-xl text-sm transition shadow flex items-center gap-2">
          <i class="fa-solid fa-plus"></i> Fund Wallet
        </button>
      </div>

      <!-- Dedicated Bank Accounts Section -->
      <div class="mt-6 pt-4 border-t border-indigo-600/50">
        <p class="text-xs text-indigo-200 mb-2 font-medium">AUTOMATED BANK ACCOUNTS (Auto-Funding)</p>
        <div class="grid grid-cols-2 md:grid-cols-3 gap-2 text-xs">
          <div class="bg-indigo-800/60 p-2 rounded-lg">
            <span class="text-indigo-300 block text-[10px]">WEMA BANK</span>
            <span class="font-bold tracking-wide">7820193840</span>
          </div>
          <div class="bg-indigo-800/60 p-2 rounded-lg">
            <span class="text-indigo-300 block text-[10px]">MONIEPOINT</span>
            <span class="font-bold tracking-wide">6401928374</span>
          </div>
          <div class="bg-indigo-800/60 p-2 rounded-lg col-span-2 md:col-span-1">
            <span class="text-indigo-300 block text-[10px]">STERLING BANK</span>
            <span class="font-bold tracking-wide">9012837461</span>
          </div>
        </div>
      </div>
    </div>

    <!-- Quick Services Grid -->
    <div>
      <h3 class="text-gray-800 font-bold text-lg mb-3">Quick Services</h3>
      <div class="grid grid-cols-3 md:grid-cols-4 gap-3">
        
        <a href="#" class="bg-white p-4 rounded-xl shadow-sm hover:shadow-md transition text-center flex flex-col items-center justify-center gap-2 border border-gray-100">
          <div class="w-12 h-12 rounded-full bg-blue-100 text-blue-600 flex items-center justify-center text-xl">
            <i class="fa-solid fa-wifi"></i>
          </div>
          <span class="text-xs font-semibold text-gray-700">Buy Data</span>
        </a>

        <a href="#" class="bg-white p-4 rounded-xl shadow-sm hover:shadow-md transition text-center flex flex-col items-center justify-center gap-2 border border-gray-100">
          <div class="w-12 h-12 rounded-full bg-green-100 text-green-600 flex items-center justify-center text-xl">
            <i class="fa-solid fa-phone"></i>
          </div>
          <span class="text-xs font-semibold text-gray-700">Buy Airtime</span>
        </a>

        <a href="#" class="bg-white p-4 rounded-xl shadow-sm hover:shadow-md transition text-center flex flex-col items-center justify-center gap-2 border border-gray-100">
          <div class="w-12 h-12 rounded-full bg-purple-100 text-purple-600 flex items-center justify-center text-xl">
            <i class="fa-solid fa-tv"></i>
          </div>
          <span class="text-xs font-semibold text-gray-700">Cable TV</span>
        </a>

        <a href="#" class="bg-white p-4 rounded-xl shadow-sm hover:shadow-md transition text-center flex flex-col items-center justify-center gap-2 border border-gray-100">
          <div class="w-12 h-12 rounded-full bg-amber-100 text-amber-600 flex items-center justify-center text-xl">
            <i class="fa-solid fa-bolt"></i>
          </div>
          <span class="text-xs font-semibold text-gray-700">Electricity</span>
        </a>

        <a href="#" class="bg-white p-4 rounded-xl shadow-sm hover:shadow-md transition text-center flex flex-col items-center justify-center gap-2 border border-gray-100">
          <div class="w-12 h-12 rounded-full bg-red-100 text-red-600 flex items-center justify-center text-xl">
            <i class="fa-solid fa-graduation-cap"></i>
          </div>
          <span class="text-xs font-semibold text-gray-700">Exam Pins</span>
        </a>

        <a href="#" class="bg-white p-4 rounded-xl shadow-sm hover:shadow-md transition text-center flex flex-col items-center justify-center gap-2 border border-gray-100">
          <div class="w-12 h-12 rounded-full bg-teal-100 text-teal-600 flex items-center justify-center text-xl">
            <i class="fa-solid fa-money-bill-transfer"></i>
          </div>
          <span class="text-xs font-semibold text-gray-700">Airtime Cash</span>
        </a>

      </div>
    </div>

    <!-- Recent Transactions Table -->
    <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-4">
      <div class="flex justify-between items-center mb-4">
        <h3 class="text-gray-800 font-bold text-lg">Recent Transactions</h3>
        <a href="#" class="text-xs font-semibold text-indigo-600 hover:underline">View All</a>
      </div>

      <div class="space-y-3">
        <!-- Transaction Item 1 -->
        <div class="flex justify-between items-center p-3 bg-gray-50 rounded-lg">
          <div class="flex items-center gap-3">
            <div class="w-10 h-10 rounded-full bg-blue-100 text-blue-600 flex items-center justify-center text-sm font-bold">
              <i class="fa-solid fa-wifi"></i>
            </div>
            <div>
              <p class="text-sm font-bold text-gray-800">MTN 2.0 GB SME</p>
              <p class="text-xs text-gray-500">08123456789 • Today, 2:15 PM</p>
            </div>
          </div>
          <div class="text-right">
            <p class="text-sm font-bold text-gray-800">₦ 520.00</p>
            <span class="inline-block bg-emerald-100 text-emerald-700 text-[10px] font-bold px-2 py-0.5 rounded-full">Successful</span>
          </div>
        </div>

        <!-- Transaction Item 2 -->
        <div class="flex justify-between items-center p-3 bg-gray-50 rounded-lg">
          <div class="flex items-center gap-3">
            <div class="w-10 h-10 rounded-full bg-emerald-100 text-emerald-600 flex items-center justify-center text-sm font-bold">
              <i class="fa-solid fa-wallet"></i>
            </div>
            <div>
              <p class="text-sm font-bold text-gray-800">Wallet Funding</p>
              <p class="text-xs text-gray-500">Monnify Transfer • Yesterday</p>
            </div>
          </div>
          <div class="text-right">
            <p class="text-sm font-bold text-emerald-600">+₦ 5,000.00</p>
            <span class="inline-block bg-emerald-100 text-emerald-700 text-[10px] font-bold px-2 py-0.5 rounded-full">Successful</span>
          </div>
        </div>
      </div>
    </div>

  </main>

</body>
</html>

