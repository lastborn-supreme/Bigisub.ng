<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Bigisub.ng | Cheap Data Dashboard</title>
  <style>
    :root {
      --bg-gradient: radial-gradient(circle at top, #1a2332 0%, #0a0d14 100%);
      --card-bg: rgba(22, 28, 39, 0.85);
      --card-border: rgba(255, 255, 255, 0.08);
      --input-bg: #111622;
      --input-border: #242e42;
      --text-main: #f8fafc;
      --text-muted: #94a3b8;
      --text-label: #cbd5e1;
      --accent-green: #10b981;
      --accent-green-hover: #059669;
      --accent-blue: #38bdf8;
      --mtn-yellow: #ffcc00;
      --airtel-red: #ef4444;
      --glo-green: #22c55e;
      --mobile-green: #84cc16;
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
    }

    body {
      background: var(--bg-gradient);
      color: var(--text-main);
      min-height: 100vh;
      padding: 20px 12px;
      display: flex;
      justify-content: center;
    }

    .container {
      width: 100%;
      max-width: 600px;
      display: flex;
      flex-direction: column;
      gap: 20px;
    }

    .navbar {
      display: flex;
      justify-content: space-between;
      align-items: center;
      background: var(--card-bg);
      border: 1px solid var(--card-border);
      padding: 16px 20px;
      border-radius: 16px;
      backdrop-filter: blur(12px);
    }

    .brand-title {
      font-size: 1.4rem;
      font-weight: 800;
      color: var(--text-main);
    }

    .logout-btn {
      color: #ef4444;
      text-decoration: none;
      font-size: 0.85rem;
      font-weight: 600;
      padding: 6px 12px;
      border: 1px solid rgba(239, 68, 68, 0.2);
      border-radius: 8px;
    }

    .wallet-card {
      background: linear-gradient(135deg, #059669 0%, #10b981 100%);
      border-radius: 20px;
      padding: 24px;
      color: #ffffff;
      box-shadow: 0 15px 30px -10px rgba(16, 185, 129, 0.4);
    }

    .wallet-top {
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    .wallet-label {
      font-size: 0.85rem;
      opacity: 0.9;
      text-transform: uppercase;
    }

    .badge-reseller {
      background: rgba(0, 0, 0, 0.25);
      font-size: 0.75rem;
      padding: 4px 10px;
      border-radius: 20px;
      font-weight: 600;
    }

    .wallet-balance {
      font-size: 2.2rem;
      font-weight: 800;
      margin: 8px 0 20px 0;
    }

    .wallet-actions {
      display: flex;
      gap: 10px;
    }

    .btn-action {
      flex: 1;
      padding: 11px;
      background: rgba(255, 255, 255, 0.2);
      border: 1px solid rgba(255, 255, 255, 0.3);
      color: #ffffff;
      font-weight: 600;
      border-radius: 10px;
      cursor: pointer;
    }

    .section-card {
      background: var(--card-bg);
      border: 1px solid var(--card-border);
      border-radius: 20px;
      padding: 24px;
      backdrop-filter: blur(12px);
    }

    .section-title {
      font-size: 1.1rem;
      font-weight: 700;
      margin-bottom: 16px;
    }

    .network-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 10px;
      margin-bottom: 16px;
    }

    .network-btn {
      background: var(--input-bg);
      border: 1px solid var(--input-border);
      padding: 12px 6px;
      border-radius: 12px;
      color: #fff;
      font-size: 0.85rem;
      font-weight: 700;
      cursor: pointer;
      text-align: center;
      transition: all 0.2s;
    }

    .network-btn.active-mtn { border-color: var(--mtn-yellow); color: var(--mtn-yellow); background: rgba(255, 204, 0, 0.05); }
    .network-btn.active-airtel { border-color: var(--airtel-red); color: var(--airtel-red); background: rgba(239, 68, 68, 0.05); }
    .network-btn.active-glo { border-color: var(--glo-green); color: var(--glo-green); background: rgba(34, 197, 94, 0.05); }
    .network-btn.active-9mobile { border-color: var(--mobile-green); color: var(--mobile-green); background: rgba(132, 204, 22, 0.05); }

    .form-group { margin-bottom: 16px; }
    .form-label { display: block; font-size: 0.85rem; color: var(--text-muted); margin-bottom: 6px; }

    .form-select, .form-input {
      width: 100%;
      background: var(--input-bg);
      border: 1px solid var(--input-border);
      border-radius: 10px;
      padding: 12px 14px;
      color: var(--text-main);
      font-size: 0.9rem;
      outline: none;
    }

    .btn-buy {
      width: 100%;
      padding: 14px;
      background: var(--accent-green);
      color: #ffffff;
      font-weight: 700;
      border: none;
      border-radius: 10px;
      cursor: pointer;
    }

    .services-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 12px;
    }

    .service-item {
      background: var(--input-bg);
      border: 1px solid var(--input-border);
      padding: 14px 8px;
      border-radius: 14px;
      text-align: center;
      cursor: pointer;
      transition: transform 0.2s;
    }

    .service-item:hover { transform: translateY(-2px); border-color: var(--accent-green); }
    .service-icon { font-size: 1.4rem; margin-bottom: 4px; }
    .service-name { font-size: 0.8rem; font-weight: 600; color: var(--text-label); }

    .promo-banner {
      background: linear-gradient(135deg, #1e293b, #0f172a);
      border: 1px solid var(--accent-blue);
      border-radius: 16px;
      padding: 16px;
      display: flex;
      align-items: center;
      justify-content: space-between;
    }

    .promo-text h3 { font-size: 0.95rem; color: var(--accent-blue); }
    .promo-text p { font-size: 0.8rem; color: var(--text-muted); margin-top: 2px; }
  </style>
</head>
<body>

  <div class="container">
    <header class="navbar">
      <h1 class="brand-title">Bigisub.ng</h1>
      <a href="index.html" class="logout-btn">Log Out</a>
    </header>

    <section class="wallet-card">
      <div class="wallet-top">
        <span class="wallet-label">Wallet Balance</span>
        <span class="badge-reseller">Reseller Account</span>
      </div>
      <div class="wallet-balance">₦18,500.00</div>
      <div class="wallet-actions">
        <button class="btn-action">+ Fund Wallet</button>
        <button class="btn-action">Airtime to Cash</button>
      </div>
    </section>

    <div class="promo-banner">
      <div class="promo-text">
        <h3>🔥 MTN SME Data Price Dropped!</h3>
        <p>1GB SME is now ₦260 for all active users.</p>
      </div>
    </div>

    <section class="section-card">
      <h2 class="section-title">Buy Cheap Data</h2>

      <label class="form-label">Select Network</label>
      <div class="network-grid">
        <button type="button" class="network-btn active-mtn" onclick="selectNetwork(this, 'active-mtn')">MTN</button>
        <button type="button" class="network-btn" onclick="selectNetwork(this, 'active-airtel')">AIRTEL</button>
        <button type="button" class="network-btn" onclick="selectNetwork(this, 'active-glo')">GLO</button>
        <button type="button" class="network-btn" onclick="selectNetwork(this, 'active-9mobile')">9MOBILE</button>
      </div>

      <form onsubmit="handleDataPurchase(event)">
        <div class="form-group">
          <label class="form-label">Data Type</label>
          <select class="form-select" required>
            <option value="sme">SME Data (Cheapest & Fast)</option>
            <option value="cg">Corporate Gifting (CG)</option>
            <option value="gifting">Direct Gifting</option>
          </select>
        </div>

        <div class="form-group">
          <label class="form-label">Data Plan</label>
          <select class="form-select" required>
            <option value="">Choose a plan...</option>
            <option value="500mb">500 MB - (₦130)</option>
            <option value="1gb">1.0 GB - 30 Days (₦260)</option>
            <option value="2gb">2.0 GB - 30 Days (₦520)</option>
            <option value="3gb">3.0 GB - 30 Days (₦780)</option>
            <option value="5gb">5.0 GB - 30 Days (₦1,300)</option>
            <option value="10gb">10.0 GB - 30 Days (₦2,600)</option>
          </select>
        </div>

        <div class="form-group">
          <label class="form-label">Recipient Phone Number</label>
          <input type="tel" class="form-input" placeholder="e.g. 08012345678" maxlength="11" required />
        </div>

        <button type="submit" class="btn-buy">Purchase Data</button>
      </form>
    </section>

    <section class="section-card">
      <h2 class="section-title">Other Services</h2>
      <div class="services-grid">
        <div class="service-item">
          <div class="service-icon">📱</div>
          <div class="service-name">Airtime Topup</div>
        </div>
        <div class="service-item">
          <div class="service-icon">📺</div>
          <div class="service-name">Cable TV (DSTV/GOtv)</div>
        </div>
        <div class="service-item">
          <div class="service-icon">💡</div>
          <div class="service-name">Electricity Bills</div>
        </div>
        <div class="service-item">
          <div class="service-icon">🎓</div>
          <div class="service-name">WAEC/NECO Pins</div>
        </div>
        <div class="service-item">
          <div class="service-icon">💸</div>
          <div class="service-name">Airtime to Cash</div>
        </div>
        <div class="service-item">
          <div class="service-icon">📊</div>
          <div class="service-name">Sales History</div>
        </div>
      </div>
    </section>
  </div>

  <script>
    function selectNetwork(element, className) {
      document.querySelectorAll('.network-btn').forEach(btn => {
        btn.className = 'network-btn';
      });
      element.classList.add(className);
    }

    function handleDataPurchase(event) {
      event.preventDefault();
      alert('Data purchase successful! Recipient will receive it shortly.');
    }
  </script>
</body>
</html>
